VITE_MQTT_URL=ws://localhost:9001

# Sensores (ESP32 publica -> React escucha)
VITE_TOPIC_TEMP=examen/esp32/temperatura
VITE_TOPIC_HUM=examen/esp32/humedad
VITE_TOPIC_LUZ=examen/esp32/luz
VITE_TOPIC_DIST=examen/esp32/distancia

# Mensajes (ESP32 publica texto -> React escucha)
VITE_TOPIC_MSG=examen/esp32/mensaje

# Botones (React publica "ON" o "OFF" -> ESP32 escucha)
VITE_TOPIC_BTN1=examen/esp32/boton1
VITE_TOPIC_BTN2=examen/esp32/boton2